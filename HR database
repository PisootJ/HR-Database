function showStaff(hIdx, pos) {
  const key = 'H' + hIdx;
  const hospData = currentSection==='civil'?(CIVIL_NAMES_LOOKUP[key]||{}):(currentSection==='pkss'?(NAMES_DATA[key]||{}):(currentSection==='gov'?(GOV_NAMES_LOOKUP[key]||{}):(currentSection==='daily'?(DAILY_NAMES_LOOKUP[key]||{}):{})));
  const staff = hospData[pos] || [];
  const hosp = getActiveData()[hIdx];
  document.getElementById('mTitle').textContent = hosp.n + '  —  ' + pos;
  document.getElementById('mSub').textContent = staff.length > 0 ? staff.length + ' คน  (เรียงอายุมาก→น้อย)' : 'ไม่มีข้อมูลรายชื่อ';
  const list = document.getElementById('mList');
  if (staff.length === 0) {
    list.innerHTML = '<div class="no-data">ไม่พบข้อมูลรายชื่อ</div>';
  } else {
    list.innerHTML = staff.map((s, i) => `
      <div class="staff-row">
        <div style="display:flex;align-items:center;gap:10px">
          <div style="width:26px;height:26px;border-radius:50%;background:#e8e0ff;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:#5b35c9">${i+1}</div>
          <span class="staff-name">${s.name}</span>
        </div>
        <div style="text-align:right">
          <span class="staff-age">${s.age || '-'}</span>
          <span class="staff-age-label">ปี</span>
        </div>
      </div>
    `).join('');
  }
  document.getElementById('staffModal').classList.add('show');
}

function closeModal() {
  document.getElementById('staffModal').classList.remove('show');
}

document.addEventListener('keydown', e => { if(e.key==='Escape') closeModal(); });


