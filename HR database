function switchSection(sec, btn) {
  currentSection = sec;
  // Move shared-content back to main-area so it doesn't get trapped inside an inactive section
  const _sc = document.getElementById('shared-content');
  const _ma = document.querySelector('.main-area');
  if(_sc && _sc.parentElement !== _ma) _ma.appendChild(_sc);
  document.querySelectorAll('.section').forEach(s=>s.classList.remove('active'));
  document.querySelectorAll('.sidebar-btn').forEach(b=>b.classList.remove('active'));
  document.getElementById('section-'+sec).classList.add('active');
  if(btn) btn.classList.add('active');
  document.getElementById('shared-content').style.display='none';
  ['civil','pkss','gov','daily'].forEach(s=>{const el=document.getElementById(s+'-own-content');if(el)el.style.display='';});
  if(sec==='civil'){
    showCivilTab('civil-overview',document.querySelector('#section-civil .tab'));
    initCivilCharts();
  } else if(sec==='gov'){
    showGovTab('gov-overview',document.querySelector('#section-gov .tab'));
    initGovCharts();
  } else if(sec==='daily'){
    showDailyTab('daily-overview',document.querySelector('#section-daily .tab'));
    initDailyCharts();
  } else {
    showPkssTab('overview',document.querySelector('#section-pkss .tab'));
  }
}

