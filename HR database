    const t=TC[i];const tot=t.total||1;
    const pct=(n)=>tot>0?(n/tot*100).toFixed(1)+'%':'—';
    tbl.innerHTML+=`<tr>
      <td style="font-weight:700;color:#9b87f5;text-align:center;font-size:16px">${i+1}</td>
      <td style="font-size:17px;font-weight:600;color:#2d3748">${h.n}</td>
      <td style="text-align:center;font-weight:700;font-size:16px;color:#2d3748">${tot}</td>
      <td style="text-align:center;font-size:20px;font-weight:800;color:#5b35c9;border-left:3px solid #c8c4d4">${t.civil}</td>
      <td style="text-align:center;font-size:12px;font-weight:600;background:${pcBgC(pct(t.civil),220)};color:#444">${pct(t.civil)}</td>
      <td style="text-align:center;font-size:20px;font-weight:800;color:#5b35c9;border-left:3px solid #c8c4d4">${t.gov}</td>
      <td style="text-align:center;font-size:12px;font-weight:600;background:${pcBgC(pct(t.gov),270)};color:#444">${pct(t.gov)}</td>
      <td class="num" style="border-left:3px solid #c8c4d4">${t.pkss}</td>
      <td style="text-align:center;font-size:12px;font-weight:600;background:${pcBgC(pct(t.pkss),255)};color:#444">${pct(t.pkss)}</td>
      <td style="text-align:center;font-size:20px;font-weight:800;color:#5b35c9;border-left:3px solid #c8c4d4">${t.daily}</td>
      <td style="text-align:center;font-size:12px;font-weight:600;background:${pcBgC(pct(t.daily),25)};color:#444">${pct(t.daily)}</td>
      <td style="text-align:center;font-size:20px;font-weight:800;color:#5b35c9;border-left:3px solid #c8c4d4">${t.other}</td>
      <td style="text-align:center;font-size:12px;font-weight:600;background:${pcBgC(pct(t.other),150)};color:#444">${pct(t.other)}</td>
    </tr>`;
  });

  // Civil donut chart
  const TOTAL_CIVIL=TC.reduce((s,t)=>s+t.civil,0);
  new Chart(document.getElementById('cCivDonut'),{
    type:'doughnut',
    data:{
      labels:H.map(h=>h.n),
      datasets:[{data:H.map((h,i)=>+(TC[i].civil/TOTAL_CIVIL*100).toFixed(1)),
        backgroundColor:CIVIL_COLORS,borderColor:'#fff',borderWidth:2,hoverOffset:8}]
    },
    options:{responsive:false,maintainAspectRatio:false,plugins:{
      legend:{display:false},
      datalabels:{display:ctx=>ctx.dataset.data[ctx.dataIndex]>=3,formatter:v=>v+'%',color:'#2d3748',font:{size:12,weight:'bold'}},
      tooltip:{callbacks:{label:c=>`${c.label}: ${c.raw}% (${TC[c.dataIndex].civil} คน)`}}
    }}
  });
  // Civil donut legend — 2 columns
  const civLeg=document.getElementById('civilDonutLegend');
  const makeCivCol=(arr,offset)=>{
    let s='<div style="display:flex;flex-direction:column;gap:10px">';
    arr.forEach((h,j)=>{
      const pct=(TC[offset+j].civil/TOTAL_CIVIL*100).toFixed(1);
      s+=`<div style="display:flex;align-items:center;gap:10px">
        <span style="width:20px;height:20px;border-radius:4px;background:${CIVIL_COLORS[offset+j]};flex-shrink:0;display:inline-block"></span>
        <span style="font-size:20px;color:#2d3748;white-space:nowrap">${h.n} <b>${pct}%</b></span>
      </div>`;
    });
    return s+'</div>';
  };
  civLeg.innerHTML=makeCivCol(H.slice(0,8),0)+makeCivCol(H.slice(8),8);

  // Civil hospital select (overview section)
  const civHospSel=document.getElementById('civilHospSel');
  H.forEach((h,i)=>{const o=document.createElement('option');o.value=i;o.text=`${h.n} (ข้าราชการ ${TC[i].civil} คน)`;civHospSel.appendChild(o);});
  renderCivilDetail();
}

function renderCivilDetail(){
  const i=parseInt(document.getElementById('civilHospSel').value)||0;
  const t=TC[i];const h=H[i];
  if(!t||!h)return;
  const pct=(n)=>(t.total>0?(n/t.total*100).toFixed(1)+'%':'—');
  document.getElementById('civilDetailBox').innerHTML=`
    <div class="kpi-grid" style="margin-bottom:16px">
      <div class="kpi purple"><div class="kpi-label">ข้าราชการ</div><div class="kpi-value">${t.civil}</div><div class="kpi-sub">${pct(t.civil)} ของ ${h.n}</div></div>
      <div class="kpi blue"><div class="kpi-label">พนักงานราชการ</div><div class="kpi-value">${t.gov}</div><div class="kpi-sub">${pct(t.gov)} ของหน่วยบริการ</div></div>
      <div class="kpi green"><div class="kpi-label">พกส.</div><div class="kpi-value">${t.pkss}</div><div class="kpi-sub">${pct(t.pkss)} ของหน่วยบริการ</div></div>
      <div class="kpi orange"><div class="kpi-label">ลูกจ้างชั่วคราวรายวัน</div><div class="kpi-value">${t.daily}</div><div class="kpi-sub">${pct(t.daily)} ของหน่วยบริการ</div></div>
    </div>
    <div class="card">
      <div class="card-title">สัดส่วนประเภทการจ้าง — ${h.n}</div>
      <div style="max-width:500px;margin:0 auto"><canvas id="cCivDetail" height="160"></canvas></div>
    </div>`;
  new Chart(document.getElementById('cCivDetail'),{
    type:'doughnut',
    data:{labels:['ข้าราชการ','พนักงานราชการ','พกส.','ลูกจ้างรายวัน','อื่นๆ'],
      datasets:[{data:[t.civil,t.gov,t.pkss,t.daily,t.other],
        backgroundColor:['#93b8f8','#c0a0f8','#b0a0f8','#f8bc88','#88c8a8'],borderWidth:2,borderColor:'#fff',hoverOffset:6}]},
    options:{responsive:true,plugins:{
      legend:{position:'right',labels:{font:{size:14},padding:12,boxWidth:14}},
      datalabels:{display:ctx=>ctx.dataset.data[ctx.dataIndex]>0,
        formatter:(v)=>{const s=t.civil+t.gov+t.pkss+t.daily+t.other;return (v/s*100).toFixed(1)+'%';},
        color:'#2d3748',font:{size:12,weight:'bold'}},
      tooltip:{callbacks:{label:c=>`${c.label}: ${c.raw} คน (${(c.raw/t.total*100).toFixed(1)}%)`}}
    }}
  });
}

// Auto-init civil charts on page load (default section = civil)
initCivilCharts();

</script></body></html>
