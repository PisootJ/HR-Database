function showSharedTab(name,el){
  const sc = document.getElementById('shared-content');
  // Always keep shared-content at main-area level (sibling of sections)
  // so it inherits the full width regardless of which section is active
  const mainArea = document.querySelector('.main-area');
  if(sc.parentElement !== mainArea) mainArea.appendChild(sc);
  document.getElementById('civil-own-content').style.display='none';
  document.getElementById('pkss-own-content').style.display='none';
  const _gC=document.getElementById('gov-own-content');if(_gC)_gC.style.display='none';
  const _dC=document.getElementById('daily-own-content');if(_dC)_dC.style.display='none';
  sc.style.display='block';
  document.querySelectorAll('#shared-content .panel').forEach(p=>p.classList.remove('active'));
  document.getElementById('shared-'+name).classList.add('active');
  document.querySelectorAll('#section-civil .tab, #section-pkss .tab, #section-gov .tab, #section-daily .tab').forEach(t=>t.classList.remove('active'));
  if(el) el.classList.add('active');
  onSectionChange();
  setTimeout(()=>window.dispatchEvent(new Event('resize')), 30);
}
