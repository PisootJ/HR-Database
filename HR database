<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dashboard พกส. จังหวัดกาญจนบุรี 2569</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/chartjs-plugin-datalabels/2.2.0/chartjs-plugin-datalabels.min.js"></script>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Sarabun','Noto Sans Thai',sans-serif;background:#f5f0ff;color:#2d3748;font-size:15px}
.header{background:linear-gradient(135deg,#d4c5f9,#fbc8d4);padding:22px 28px;color:#3d1a78}
.header h1{font-size:22px;font-weight:800;margin-bottom:3px}
.header p{font-size:13px;opacity:.8}
.tabs{display:flex;gap:3px;padding:14px 28px 0;background:#ede8ff;border-bottom:1px solid #d0c7f7;overflow-x:auto}
.tab{padding:9px 18px;border-radius:8px 8px 0 0;cursor:pointer;font-size:13px;font-weight:600;white-space:nowrap;background:transparent;border:none;color:#7c6b9e;transition:.2s}
.tab.active{background:#fff;color:#5b35c9;border-bottom:3px solid #7c60d5}
.tab:hover:not(.active){background:#e0d8ff}
.content{padding:20px 28px}
.panel{display:none}.panel.active{display:block}
.kpi-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px;margin-bottom:20px}
.kpi{background:#fff;border-radius:12px;padding:18px 20px;border:1px solid #e2daf7;box-shadow:0 2px 6px rgba(0,0,0,.05)}
.kpi-label{font-size:12px;color:#9b87c2;margin-bottom:4px}
.kpi-value{font-size:44px;font-weight:800;line-height:1}
.kpi-sub{font-size:11px;color:#aaa;margin-top:4px}
.kpi.purple{background:#f0ebff}.kpi.purple .kpi-value{color:#5b35c9}
.kpi.pink{background:#fff0f6}.kpi.pink .kpi-value{color:#c2185b}
.kpi.blue{background:#e8f4ff}.kpi.blue .kpi-value{color:#1565c0}
.kpi.green{background:#e8f8ef}.kpi.green .kpi-value{color:#1b7a40}
.card{background:#fff;border-radius:12px;padding:18px 22px;border:1px solid #e2daf7;margin-bottom:16px;box-shadow:0 2px 6px rgba(0,0,0,.04)}
.card-title{font-size:15px;font-weight:700;color:#3d1a78;margin-bottom:14px}
table{width:100%;border-collapse:collapse}
th{background:#f3eeff;color:#5b35c9;font-size:14px;padding:10px 12px;text-align:left;border-right:1px solid #ddd8e8}
td{padding:9px 12px;border-bottom:1px solid #d0c8dc;border-right:1px solid #ddd8e8;font-size:13px}
tr:hover td{background:#fbf9ff}
td:last-child,th:last-child{border-right:none}
.num{font-size:20px;font-weight:800;color:#5b35c9;text-align:center}
select{width:100%;padding:9px 12px;border-radius:8px;border:1px solid #d0c7f7;font-size:14px;margin-bottom:16px;color:#2d3748;background:#fff}
.pos-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:10px}
.pos-item{display:flex;justify-content:space-between;align-items:center;padding:7px 12px;border-radius:8px;background:#f9f7ff;font-size:12px}
.pos-count{font-size:18px;font-weight:800;color:#5b35c9}
.opt-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.opt-card{background:#fff;border-radius:12px;padding:18px;border:2px solid #e8e0ff}
.opt-card h3{font-size:14px;font-weight:700;color:#3d1a78;margin:6px 0}
.opt-card p{font-size:12px;color:#6b7280;line-height:1.6;margin-bottom:10px}
.opt-list{list-style:none}
.opt-list li{padding:5px 0;font-size:12px;border-bottom:1px dashed #e8e0ff;color:#374151}
.opt-list li:last-child{border-bottom:none}
.opt-list li::before{content:"→ ";color:#9b87f5;font-weight:700}
.tag{display:inline-block;padding:2px 8px;border-radius:4px;font-size:10px;font-weight:700;margin-bottom:4px}
.tag.r{background:#ffe4e8;color:#c2185b}
.tag.y{background:#fff3cd;color:#856404}
.tag.g{background:#d1f5dc;color:#0a6640}
.two-col{display:grid;grid-template-columns:1fr 1fr;gap:16px}
@media(max-width:700px){.opt-grid,.two-col,.pos-grid{grid-template-columns:1fr}.kpi-value{font-size:34px}}

.pos-item{cursor:pointer;transition:background .18s}
.pos-item:hover{background:#e9e2ff;transform:translateX(2px)}
#staffModal{display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(61,26,120,.45);z-index:1000;align-items:center;justify-content:center}
#staffModal.show{display:flex}
.modal-box{background:#fff;border-radius:18px;padding:28px 24px;max-width:500px;width:92%;max-height:78vh;overflow-y:auto;position:relative;box-shadow:0 8px 40px rgba(91,53,201,.18)}
.modal-title{font-size:17px;font-weight:800;color:#3d1a78;margin-bottom:4px}
.modal-sub{font-size:12px;color:#9b87c2;margin-bottom:16px;padding-bottom:12px;border-bottom:1px solid #f0ebff}
.staff-row{display:flex;justify-content:space-between;align-items:center;padding:9px 14px;border-radius:10px;margin-bottom:6px;background:#f9f7ff}
.staff-row:nth-child(even){background:#f3eeff}
.staff-name{font-size:13px;font-weight:600;color:#2d3748}
.staff-age{font-size:20px;font-weight:800;color:#5b35c9;margin-left:12px}
.staff-age-label{font-size:10px;color:#aaa;display:block;text-align:right}
.no-data{text-align:center;color:#aaa;font-size:13px;padding:20px}
.modal-close{position:absolute;top:12px;right:16px;font-size:24px;cursor:pointer;color:#c4b5f7;background:none;border:none;line-height:1;padding:4px 8px;border-radius:6px}
.modal-close:hover{background:#f0ebff;color:#5b35c9}

.kpi.orange{background:linear-gradient(135deg,#fff3e0,#ffe0b2);border-left:4px solid #ff9800}
.kpi.orange .kpi-value{color:#e65100}
.retire-year-group{margin-bottom:18px}
.retire-year-header{background:#fff3e0;border-radius:10px;padding:8px 14px;margin-bottom:8px;display:flex;align-items:center;gap:10px}
.retire-year-badge{font-size:20px;font-weight:800;color:#e65100}
.retire-year-label{font-size:13px;color:#9b87c2}
.retire-row{display:flex;justify-content:space-between;align-items:center;padding:11px 16px;border-radius:10px;margin-bottom:6px;background:#f9f7ff;gap:12px}
.retire-row:nth-child(even){background:#f3eeff}
.retire-name{font-size:16px;font-weight:600;color:#2d3748;flex:1}
.retire-pos{font-size:14px;color:#9b87c2;flex:1.2}
.retire-age{font-size:20px;font-weight:800;color:#e65100;min-width:40px;text-align:right}

.app-body{display:flex;min-height:calc(100vh - 90px)}
.sidebar{width:160px;min-width:160px;background:#2d1b6b;padding:16px 10px;display:flex;flex-direction:column;gap:8px;position:sticky;top:0;height:100vh;overflow-y:auto}
.sidebar-btn{width:100%;padding:10px 10px;border:none;border-radius:10px;font-size:14px;font-weight:700;cursor:pointer;color:#c8b8f8;background:transparent;text-align:left;transition:all .2s;letter-spacing:.3px}
.sidebar-btn.active,.sidebar-btn:hover{background:#5b35c9;color:#fff}
.sidebar-title{color:#9b87c2;font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:1px;padding:4px 8px;margin-top:4px}
.main-area{flex:1;min-width:0}
.section{display:none}.section.active{display:block}
</style>
</head>
