  const canvas = document.getElementById('cRetire');
  retireChart = new Chart(canvas,{
    type:'bar',
    data:{
      labels:hospNames,
      datasets:[{
        label: 'จำนวน '+getActiveLabel()+' เกษียณ',
        data:counts,
        backgroundColor:colors,
        borderRadius:6,
        borderWidth:2,
