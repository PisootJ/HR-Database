    <div style="display:flex;justify-content:center;align-items:center;gap:48px;flex-wrap:wrap;padding:16px 0">
      <canvas id="cCivDonut" style="width:460px;height:460px;flex-shrink:0"></canvas>
      <div id="civilDonutLegend" style="display:flex;gap:16px 40px"></div>
    </div>
  </div>
</div>

</div>
</div><!-- end section-civil -->

