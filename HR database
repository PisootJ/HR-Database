        hoverBorderColor: colors.map(c=>c),
        hoverBorderWidth:2,
      }]
    },
    options:{
      responsive:true,
      layout:{padding:{top:50}},
      onClick:(event, elements)=>{
        if(elements.length>0){
          const idx=elements[0].index;
          rHospSel.value=idx;
          renderRetireDetail();
          setTimeout(()=>document.getElementById('retireDetailCard').scrollIntoView({behavior:'smooth',block:'nearest'}),80);
        }
      },
      onHover:(event,els)=>{
        canvas.style.cursor=els.length>0?'pointer':'default';
      },
      plugins:{
        legend:{display:false},
        datalabels:{
          anchor:'end',align:'end',
          font:{size:13,weight:'bold'},
          color:'#5b35c9',
          formatter:v=>v>0?v:''
        },
        tooltip:{
          backgroundColor:'rgba(45,27,107,0.93)',
          titleColor:'#e8e0ff',
          bodyColor:'#f0ebff',
          footerColor:'#c4b5f7',
          padding:12,
          bodySpacing:5,
          footerSpacing:4,
          footerFont:{size:11,style:'italic'},
          callbacks:{
            label: c => ` รวม ${c.raw} คน`,
            afterBody: (contexts) => {
              if(!contexts.length || !contexts[0].raw) return [];
              const idx = contexts[0].dataIndex;
              const staff = RETIRE_R['H'+idx]?.[fy] || [];
              if(!staff.length) return [];
              const posCounts = {};
              staff.forEach(s => { posCounts[s.pos] = (posCounts[s.pos]||0)+1; });
              const lines = Object.entries(posCounts)
                .sort((a,b)=>b[1]-a[1])
                .map(([pos,cnt])=>`  · ${pos}  ${cnt} คน`);
              return ['', ...lines, ''];
            },
            footer: () => ' 👆 คลิกดูรายชื่อทั้งหมด'
          }
        }
      },
      scales:{
        x:{grid:{display:false},ticks:{font:{size:11},maxRotation:40,minRotation:30}},
        y:{grid:{color:'#f0ebff'},ticks:{font:{size:12}},beginAtZero:true,suggestedMax:Math.max(...counts)+1}
      }
    }
  });
}

function renderRetireDetail() {
