const CURRENT_FY = 2569;
const FY_LIST = [2570,2571,2572,2573,2574];

// Populate hospital selector for retirement tab
const rHospSel = document.getElementById('retireHospSel');

function populateHospSel(){
  const DATA = getActiveData();
  const sel = document.getElementById('hospSel');
  if(!sel) return;
  sel.innerHTML='';
  DATA.forEach((h,i)=>{const o=document.createElement('option');o.value=i;o.text=h.n+'  ('+h.t+' คน)';sel.appendChild(o);});
  sel.selectedIndex=0;
}

function populateRHospSel(){
  const DATA = getActiveData();
  const RETIRE = getActiveRetire();
  rHospSel.innerHTML='';
  DATA.forEach((h,i)=>{
    const total=FY_LIST.reduce((s,fy)=>s+(RETIRE['H'+i]?.[fy]?.length||0),0);
    const o=document.createElement('option');o.value=i;o.text=h.n+'  ('+total+' คน)';
    rHospSel.appendChild(o);
  });
}

function populatePosSelect(){
  const DATA = getActiveData();
  const allPosSet=new Set();
  DATA.forEach(h=>Object.keys(h.p).forEach(k=>allPosSet.add(k)));
  const list=[...allPosSet].sort((a,b)=>{
    const ta=DATA.reduce((s,h)=>s+(h.p[a]||0),0);
    const tb=DATA.reduce((s,h)=>s+(h.p[b]||0),0);
    return tb-ta;
  });
  const pSel = document.getElementById('posSelect');
  if(!pSel) return;
  pSel.innerHTML='';
  list.forEach(p=>{const o=document.createElement('option');const tot=DATA.reduce((s,h)=>s+(h.p[p]||0),0);o.value=p;o.text=p+'  (รวม '+tot+' คน)';pSel.appendChild(o);});
  pSel.selectedIndex=0;
}

function updateRetireKPIs(){
  const DATA = getActiveData();
  const RETIRE = getActiveRetire();
  const lbl = getActiveLabel();
  const fyTotals={};
  FY_LIST.forEach(fy=>{fyTotals[fy]=DATA.reduce((s,_,i)=>s+(RETIRE['H'+i]?.[fy]?.length||0),0);});
  const total5=Object.values(fyTotals).reduce((a,b)=>a+b,0);
  const bestFY=FY_LIST.reduce((a,b)=>fyTotals[b]>fyTotals[a]?b:a);
  const hospTotals=DATA.map((_,i)=>FY_LIST.reduce((s,fy)=>s+(RETIRE['H'+i]?.[fy]?.length||0),0));
  const bestH=hospTotals.indexOf(Math.max(...hospTotals));
  document.getElementById('retireKpiLabel').textContent=lbl+' เกษียณใน 5 ปี';
  document.getElementById('retireKpi1').textContent=total5;
  document.getElementById('retireKpi2').textContent=bestFY;
  document.getElementById('retireKpi2sub').textContent=fyTotals[bestFY]+' คน';
  document.getElementById('retireKpi3').textContent=DATA[bestH]?.s||'-';
  document.getElementById('retireKpi3sub').textContent=hospTotals[bestH]+' คน';
  document.getElementById('retireKpi4').textContent=(total5/5).toFixed(1);
  document.getElementById('retireChartTitle').textContent='จำนวน '+lbl+' ที่จะเกษียณรายหน่วย — เลือกปีงบ';
  document.getElementById('retireDetailTitle').textContent='รายชื่อ '+lbl+' ที่จะเกษียณ — เลือกหน่วยบริการ';
}

